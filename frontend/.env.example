# ==============================================================================
# Navin Frontend Environment Variables Configuration Example
# ==============================================================================
# Copy this file to a new file named '.env' in the same directory and adjust values.
# Vite requires frontend variables to be prefixed with 'VITE_' to be exposed.

# The primary base URL for backend API communications (e.g., local development server)
# Required for Axios network operations to function correctly.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional: Set the application environment (development, staging, production)
VITE_APP_ENV=development

# Sentry error monitoring DSN. Get this from your Sentry project settings:
# https://docs.sentry.io/product/sentry-basics/concepts/dsn-explainer/
# Sentry only initializes in production builds (import.meta.env.PROD).
VITE_SENTRY_DSN=

# Optional: Application version for Sentry release tracking (set during CI build)
VITE_APP_VERSION=

# Stellar network for wallet signing. 'testnet' for development, 'mainnet' for production.
# Read by WalletContext and all wallet adapters — never hardcode in source files.
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint for contract calls. Defaults to https://soroban-testnet.stellar.org.
# Use https://soroban-mainnet.stellar.org for mainnet, or a private RPC for performance.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Smart contract ID for the escrow contract. Every escrow operation requires this.
# Get the address from your contract deployment logs or GitHub releases.
VITE_ESCROW_CONTRACT_ID=

# Set to 'true' to skip the realtime SSE/polling connection.
# The backend does not serve /api/events yet, so leaving this unset produces
# repeated 404s from realtimeService.
VITE_DISABLE_REALTIME=true